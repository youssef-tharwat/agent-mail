{"version": 2, "width": 90, "height": 16, "title": "Agent Mail CLI demo: real CLI output, disposable database, simulated Herdr bindings", "env": {"TERM": "xterm-256color"}}
[0.0, "o", "\u001b[2J\u001b[H\u001b[90m# Send a request\u001b[0m\r\n\r\n"]
[0.0, "o", "\u001b[32mcoordinator $ \u001b[0m"]
[0.167, "o", "agent-"]
[0.25, "o", "mail s"]
[0.333, "o", "end --"]
[0.417, "o", "to wor"]
[0.5, "o", "ker --"]
[0.583, "o", "key re"]
[0.667, "o", "view-1"]
[0.75, "o", " \\\r\n  -"]
[0.833, "o", "-summa"]
[0.917, "o", "ry 'Pl"]
[1.0, "o", "ease r"]
[1.083, "o", "eview "]
[1.167, "o", "abc123"]
[1.25, "o", "' --wo"]
[1.333, "o", "rk-id "]
[1.417, "o", "api-re"]
[1.5, "o", "view"]
[1.5, "o", "\r\n{\"id\":1,\"persisted\":true}\r\n"]
[4.0, "o", "\u001b[2J\u001b[H\u001b[90m# Recover work after a context reset\u001b[0m\r\n\r\n"]
[4.0, "o", "\u001b[32mworker $ \u001b[0m"]
[4.167, "o", "agent-"]
[4.25, "o", "mail c"]
[4.333, "o", "ontext"]
[4.417, "o", " | jq "]
[4.5, "o", "'{\r\n  n"]
[4.583, "o", "ext: ."]
[4.667, "o", "work[0"]
[4.75, "o", "].next"]
[4.833, "o", "_actio"]
[4.917, "o", "n,\r\n  r"]
[5.0, "o", "equest"]
[5.083, "o", ": .mai"]
[5.167, "o", "l[0].s"]
[5.25, "o", "ummary"]
[5.333, "o", "\r\n}'"]
[5.333, "o", "\r\n{\r\n  \"next\": \"Review API changes\",\r\n  \"request\": \"Please review abc123\"\r\n}\r\n"]
[8.333, "o", "\u001b[2J\u001b[H\u001b[90m# Resolve explicitly\u001b[0m\r\n\r\n"]
[8.333, "o", "\u001b[32mworker $ \u001b[0m"]
[8.5, "o", "agent-"]
[8.583, "o", "mail r"]
[8.667, "o", "esolve"]
[8.75, "o", " 1 --n"]
[8.833, "o", "ote 'R"]
[8.917, "o", "eviewe"]
[9.0, "o", "d abc1"]
[9.083, "o", "23'"]
[9.083, "o", "\r\n{\"id\":1,\"reply_id\":null,\"resolved\":true}\r\n"]
[10.333, "o", "\r\n"]
[10.333, "o", "\u001b[32mworker $ \u001b[0m"]
