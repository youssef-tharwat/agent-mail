+fn pane_input_target(args: &[String]) -> std::io::Result<i32> {
+    if args.len() != 4 || args[2] != "--terminal" {
+        eprintln!("usage: herdr pane input-target <pane_id> agent|terminal --terminal <observed_terminal_id>");
+        return Ok(2);
