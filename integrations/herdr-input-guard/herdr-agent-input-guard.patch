@@ -0,0 +1,29 @@
+//! Persistent intended recipient of automation input, independent of liveness.
+#[derive(
+    Debug,
+    Clone,
+    Copy,
+    Default,
+    PartialEq,
+    Eq,
+    serde::Serialize,
+    serde::Deserialize,
+    schemars::JsonSchema,
+)]
+#[serde(rename_all = "snake_case")]
+pub enum InputTarget {
+    #[default]
+    Terminal,
+    Agent,
+}
+
+impl std::str::FromStr for InputTarget {
+    type Err = String;
+    fn from_str(value: &str) -> Result<Self, Self::Err> {
+        match value {
+            "agent" => Ok(Self::Agent),
+            "terminal" => Ok(Self::Terminal),
+            _ => Err("input target must be agent or terminal".into()),
+        }
+    }
+}
