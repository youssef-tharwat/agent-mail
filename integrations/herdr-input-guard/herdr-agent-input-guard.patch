+            eprintln!("{error}");
+            return Ok(2);
+        }
+    };
+    super::print_response(&super::send_request(&Request {
+        id: "cli:pane:input-target".into(),
+        method: Method::PaneInputTargetSet(crate::api::schema::PaneInputTargetSetParams {
+            pane_id: super::normalize_pane_id(&args[0]),
+            terminal_id: args[3].clone(),
+            target,
